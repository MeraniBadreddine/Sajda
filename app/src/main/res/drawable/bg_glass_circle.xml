<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#CC1C1C1E" />
            <stroke android:width="0.5dp" android:color="#47FFFFFF" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="18dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
